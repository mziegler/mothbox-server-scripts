[Unit]
Description=Mothbox Photo Collection and AI Processing
After=network-online.target snap.docker.dockerd.service
Requires=snap.docker.dockerd.service

[Service]
Type=simple
User=mb
WorkingDirectory=/home/mb/mothbox-server-scripts

# Use the full path to docker to avoid PATH issues in the systemd environment.
# Run `which docker` on the server to confirm this path if it differs.
ExecStart=/snap/bin/docker compose up
ExecStop=/snap/bin/docker compose down


# Restart=always, not on-failure: docker (snap-installed) auto-refreshes
# periodically and restarts dockerd, which kills this attached `docker
# compose up` foreground process with a clean exit (status 0) -- not a
# crash, so on-failure would never restart it. Confirmed cause of a 4-day
# outage on 2026-07-24: dockerd restarted, this unit (and the two antenna
# units) went "inactive (dead)" cleanly and never came back on their own.
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
